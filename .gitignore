# ==============================================================================
# .gitignore - ADITS (Audio-Driven IoT Task Scheduler) Humanoid Robot
# Universitas Negeri Malang - Tim Peneliti Dewantara (KRSTI)
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions & build
build/
dist/
*.egg-info/

# Virtual Environments
venv/
env/
ENV/
venv.bak/

# Temporary evaluation runs & session logs
hasil_evaluasi_grand_unified_*.xlsx
*.log

# Binary caches & temporary data
*.npy
.cache/

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Office temporary lock files
~$*.docx
~$*.xlsx

# Archive legacy backups
legacy_archive/
